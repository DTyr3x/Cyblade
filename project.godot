; Engine configuration file.
; Não edite à mão partes geradas pelo editor sem necessidade.

config_version=5

[application]

config/name="CYBLADE"
config/description="Action roguelite 3D cyberpunk, single-player e offline."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputSetup="*res://game/input/input_setup.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=120
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
